# ==============================================================================
# SentraPay Infrastructure Configuration Environment Variables
# Author: Jayavignesh (jayavignesh.dev)
# ==============================================================================

# System Timezone
TZ=Asia/Kolkata

# PostgreSQL 16 ACID Store
POSTGRES_DB=sentrapay_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

# Redis 7 In-Memory Cache, Idempotency & Rate Limiting
REDIS_PORT=6379

# Apache Kafka 3.7 (KRaft Mode)
KAFKA_PORT=29092
KAFKA_INTERNAL_PORT=9092

# JWT Security
JWT_SECRET=SentraPayEnterprisePaymentSwitchSecretKeyWith256BitsOfEntropySecureHMACSHA256
JWT_EXPIRATION_MS=86400000

# Edge Gateway Port
GATEWAY_PORT=8080

# Microservice Internal Ports
WALLET_SERVICE_PORT=8081
FRAUD_SERVICE_PORT=8082
RECON_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
ML_GRPC_PORT=50051
ML_HTTP_PORT=8000

